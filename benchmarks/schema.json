{
  "$defs": {
    "aggregate_metrics": {
      "additionalProperties": false,
      "properties": {
        "efficiency": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "hit_rate_at_10": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "mrr": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "mttc": {
          "maximum": 11,
          "minimum": 1,
          "type": "number"
        },
        "recommended_technical_score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "efficiency",
        "hit_rate_at_10",
        "mrr",
        "mttc",
        "recommended_technical_score"
      ],
      "type": "object"
    },
    "scenario_metrics": {
      "additionalProperties": false,
      "properties": {
        "hit_rate_at_10": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "mrr": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "mttc": {
          "maximum": 11,
          "minimum": 1,
          "type": "number"
        },
        "sample_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "hit_rate_at_10",
        "mrr",
        "mttc",
        "sample_count"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.invalid/ttsc/benchmarks/schema-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregate-only, append-only TTSC benchmark record. The Python recorder is authoritative for cross-field validation.",
  "properties": {
    "metrics": {
      "$ref": "#/$defs/aggregate_metrics"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "sample_count": {
      "minimum": 1,
      "type": "integer"
    },
    "scenario_metrics": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "boundary": {
          "$ref": "#/$defs/scenario_metrics"
        },
        "browsing": {
          "$ref": "#/$defs/scenario_metrics"
        },
        "buying": {
          "$ref": "#/$defs/scenario_metrics"
        },
        "intent_override": {
          "$ref": "#/$defs/scenario_metrics"
        }
      },
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "source_document": {
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$",
      "type": "string"
    },
    "system": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    }
  },
  "required": [
    "metrics",
    "record_id",
    "sample_count",
    "schema_version",
    "source_document",
    "system"
  ],
  "title": "TTSC benchmark record v1",
  "type": "object"
}
