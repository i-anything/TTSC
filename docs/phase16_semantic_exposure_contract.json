{
  "schema_version": 1,
  "experiment_id": "phase16-semantic-lexical-exposure-factorial-v1",
  "status": "frozen_public_diagnostic_only",
  "purpose": "Measure semantic-to-lexical rescue and evidence-gated exposure separately and together without changing the active starter.",
  "promotion_authority": {
    "automatic_promotion_allowed": false,
    "reason": "Only the previously used public suite is locally available; fresh target-disjoint confirmation is still required.",
    "starter_may_be_changed_by_this_run": false
  },
  "frozen_inputs": {
    "catalog": {
      "path": "data/catalog.jsonl",
      "sha256": "da979b05a68af864cb0dcf9ee6a81c010c7e66a57978ad286c7a2e005fc69a67"
    },
    "evaluation": {
      "path": "data/public_set.jsonl",
      "sha256": "857259f7a438e6188ac63e18995b6ff4489bfcfc4a716a798b9a2aa0ee8f7579",
      "expected_cases": 200,
      "reuse_classification": "previously_used_public_diagnostic"
    },
    "starter": {
      "path": "starter/agent.py",
      "sha256": "1eb6082202379c4f1af81fbd01cbca4d52c5533858d91d6eaf5450d5a2f6b2d5",
      "role": "unchanged_current_exact_evidence_reference"
    }
  },
  "fixed_shared_architecture": {
    "question_policy": "conservative_early_other",
    "fusion_policy": "completeness_adaptive",
    "ranking_policy": "phase2-lexicographic-exact-evidence-v1",
    "profile_policy": "phase9-bounded-profile-residual-v1",
    "slate_policy": "phase13-intent-epoch-continuation-novelty-v1",
    "intent_policy": "robust",
    "decision_policy": "protected_phase13",
    "requirement_probe_policy": "disabled",
    "orchestration_policy": "exact_ranking_reuse"
  },
  "arms": [
    {
      "id": "baseline",
      "semantic_lexical_rescue": "disabled",
      "evidence_exposure": "disabled"
    },
    {
      "id": "rescue_only",
      "semantic_lexical_rescue": "semantic-to-lexical-shared-terms-v1",
      "evidence_exposure": "disabled"
    },
    {
      "id": "gate_only",
      "semantic_lexical_rescue": "disabled",
      "evidence_exposure": "top3-structural-evidence-gate-v1"
    },
    {
      "id": "combined",
      "semantic_lexical_rescue": "semantic-to-lexical-shared-terms-v1",
      "evidence_exposure": "top3-structural-evidence-gate-v1"
    }
  ],
  "semantic_rescue_invariants": {
    "bm25_runs_first": true,
    "inadequate_support": [
      "BM25 errors or is empty",
      "no BM25 candidate satisfies active category and hard constraints",
      "every BM25 candidate relies only on broad category overlap"
    ],
    "dense_candidates_are_private": true,
    "expansion_sources": [
      "structured features",
      "descriptions"
    ],
    "minimum_shared_dense_hits": 3,
    "maximum_expansion_terms": 3,
    "forbidden_terms": [
      "brands",
      "product IDs",
      "numbers",
      "candidate-specific phrases"
    ],
    "catalog_frequency_minimum": 3,
    "catalog_frequency_maximum_fraction": 0.05,
    "bm25_retries": 1,
    "final_candidate_authority": "lexical_only"
  },
  "exposure_invariants": {
    "confident_prefix_maximum": 3,
    "confidence_requires": [
      "structurally compatible category",
      "support for every hard constraint",
      "no contradiction override or retrieval fallback",
      "best structural evidence tier contains at most three candidates"
    ],
    "more_than_three_with_informative_question": "withhold recommendations and ask the most discriminating question",
    "no_informative_question": "return best available slate",
    "final_turn": "return full available slate",
    "fault_behavior": "fail open to the baseline slate"
  },
  "execution": {
    "mode": "strictly_sequential_single_process_cpu",
    "arm_order": [
      "baseline",
      "rescue_only",
      "gate_only",
      "combined"
    ],
    "passes": [
      "balanced_40_case_smoke",
      "balanced_40_case_exact_replay",
      "full_200_case_public_diagnostic_if_smoke_safe"
    ],
    "fresh_agent_state_per_arm": true,
    "shared_catalog_backend": true,
    "label_free_backend_and_frequency_cache_warmup": true,
    "threads": 1,
    "processes": 1,
    "network_access": false,
    "external_model_calls": 0
  },
  "smoke_authorization": {
    "metric_direction_is_not_a_blocker": true,
    "requires": [
      "all arms produce valid API responses",
      "all arms are fault free",
      "all arms report zero token use",
      "each arm exactly replays its evaluator payload behavior and deterministic health"
    ]
  },
  "frozen_diagnostic_observations": {
    "no_baseline_only_hits": true,
    "hit_rate_not_below_baseline": true,
    "mrr_not_below_baseline": true,
    "mttc_not_above_baseline": true,
    "technical_score_not_below_baseline": true,
    "fault_free": true,
    "interpretation": "Descriptive non-regression evidence only; never an automatic adoption gate."
  },
  "privacy": {
    "published_output": "aggregate_only",
    "labels_available_to_agent": false,
    "forbidden_publication_content": [
      "product identifiers",
      "messages",
      "profiles",
      "queries",
      "candidate lists",
      "per-session outcomes"
    ]
  }
}
